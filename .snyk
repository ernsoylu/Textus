version: v1.25.1
ignore:
  SNYK-JS-ZOD-20510278:
    - '*':
        reason: >-
          No fixed zod release exists (CVE-2023-54404, all versions). Every Edge Function reads
          request bodies through jsonBody()'s 32 KB cap and request array schemas set .max(),
          so untrusted arrays stay small. Remove when zod ships a fix.
