# Build-time only (Vite inlines VITE_* at build time — see README "Frontend" section).
# Leave VITE_SUPABASE_URL empty in the Docker image: the SPA then uses its own origin and nginx
# proxies the API to Supabase over the internal Docker network (deploy/nginx.conf).
VITE_SUPABASE_URL=https://base.textus.bff.bz
VITE_SUPABASE_ANON_KEY=
