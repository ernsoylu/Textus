# Build-time only (Vite inlines VITE_* at build time — see README "Frontend" section).
# Leave VITE_SUPABASE_URL empty in the Docker image: the SPA then uses its own origin and nginx
# proxies the API to Supabase over the internal Docker network (deploy/nginx.conf).
VITE_SUPABASE_URL=https://base.textus.bff.bz
VITE_SUPABASE_ANON_KEY=

# Edge Functions only — copy these to the server's functions environment, not VITE_*.
AI_ENABLED=false
OLLAMA_URL=http://192.168.1.104:11434
OLLAMA_DEFAULT_MODEL=qwen3.5:4b
OLLAMA_ALLOWED_MODELS=qwen3.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_CONTEXT_TOKENS=4096
# OLLAMA_API_KEY=  # only for an authenticated local reverse proxy

TEXTUS_SITE_URL=https://textus.bff.bz
MCP_ALLOWED_ORIGINS=https://textus.bff.bz
# MCP_SIGNING_JWK=  # optional private ES256/EdDSA key; otherwise the existing JWT_SECRET signs internal owner tokens
MCP_ENABLED=false
MCP_WRITES_ENABLED=false
