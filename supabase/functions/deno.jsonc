// Import map for Edge Functions (Deno). Mirrors the self-hosted server's
// volumes/functions/deno.jsonc (see README "Edge Functions" deploy section) plus the
// per-function npm packages below, kept in the repo so `deno check`/`deno lint` can resolve
// imports in CI without a live server. `deno lint`'s no-import-prefix rule wants npm:/jsr:
// specifiers mapped here rather than inlined in source, so pin versions in one place.
{
  "imports": {
    "@supabase/server": "npm:@supabase/server@^1",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.103.1",
    "@modelcontextprotocol/sdk/server/mcp.js": "npm:@modelcontextprotocol/sdk@1.31.0/server/mcp.js",
    "@modelcontextprotocol/sdk/server/webStandardStreamableHttp.js": "npm:@modelcontextprotocol/sdk@1.31.0/server/webStandardStreamableHttp.js",
    "jose": "npm:jose@6.2.12",
    "@xmldom/xmldom": "npm:@xmldom/xmldom@0.9.12",
    "zod": "npm:zod@3.25.76",
    "pdfjs-dist/legacy/build/pdf.mjs": "npm:pdfjs-dist@6.3.289/legacy/build/pdf.mjs"
  }
}
